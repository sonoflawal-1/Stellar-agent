{
  "name": "marc-stellar-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "test:contract": "tsx --test test/contract/**/*.test.ts",
    "test:embeddings": "tsx --test test/embeddings/**/*.test.ts",
    "test:audit": "tsx --test test/audit/**/*.test.ts",
    "test:audit-bench": "tsx test/audit/bench-100k.ts",
    "test:all": "tsx --test && tsx --test test/contract/**/*.test.ts && tsx --test test/embeddings/**/*.test.ts && tsx --test test/audit/**/*.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@stellar/stellar-sdk": "^14.6.1",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "marc-stellar-sdk": "file:../sdk",
    "openapi-response-validator": "^12.1.3",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}