# dashboard/.env.example
# Copy to dashboard/.env and fill in values.
# See root .env.example for full variable reference.
# This file is validated against the dashboard Zod schema in CI (see dashboard/src/config.ts).

# ── Stellar network ───────────────────────────────────────────────────────────
# Must be a valid URL (http/https).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Must match the network the RPC endpoint serves.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contract addresses (testnet) ──────────────────────────────────────────────
# Must be valid Stellar StrKey contract addresses (start with "C").
USDC_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
AGENT_IDENTITY_CONTRACT=CAMPXYFZJTIPEVOPOAZPRG5OHXKNBDPGTPRCOIO4LVPGEM4TONPY65A5
AGENTIC_COMMERCE_CONTRACT=CD2KWU7IE74Z2QKVP3FQ67J46XHNMGIDTNKXVWE7ZNVRC7T6UH46GQXE

# ── Dashboard server ──────────────────────────────────────────────────────────
# Must be an integer between 1 and 65535.
DASHBOARD_PORT=3000
# Comma-separated list of allowed origins (each must be a valid URL).
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Request body limits ──────────────────────────────────────────────────────
# Global JSON body limit applied to all routes except those with a specific override.
# Accepts a byte count or a size string (e.g. 100kb, 1mb). Default: 100kb.
BODY_LIMIT_DEFAULT=100kb
# Larger body limit for /api/build/submit (build payloads can be sizable).
# Accepts a byte count or a size string (e.g. 1mb, 5mb). Default: 2mb.
BODY_LIMIT_BUILD_SUBMIT=2mb

# ── Security headers / Content-Security-Policy ───────────────────────────────
# Comma-separated allow-lists used to build the CSP served with the dashboard.
# CSP_CONNECT_SRC: origins allowed for fetch/XHR/WebSocket (RPC + CDN endpoints).
# Defaults include the Stellar RPC host and self.
CSP_CONNECT_SRC=https://soroban-testnet.stellar.org,https://cdn.jsdelivr.net
# CSP_IMG_SRC: origins allowed for images. Default: 'self' data:.
CSP_IMG_SRC='self' data:
# CSP_SCRIPT_SRC: origins allowed for scripts. Default: 'self'.
# Avoid 'unsafe-inline'; public/app.js is served from 'self'.
CSP_SCRIPT_SRC='self'

# ── Rate limiting ────────────────────────────────────────────────────────────
# Per-IP limit: max requests per window for each client IP. Default: 100.
RATE_LIMIT_IP=100
# Per-wallet limit: max requests per window keyed by wallet address. Default: 60.
RATE_LIMIT_WALLET=60
# Per-token limit: max requests per window keyed by auth token. Default: 60.
RATE_LIMIT_TOKEN=60
# Cost weight applied to embedding-heavy routes (e.g. /api/agents/match, embeddings).
# Each request on these routes consumes this many units from the bucket. Default: 5.
RATE_LIMIT_EMBEDDING_COST=5

# ── CSRF protection ──────────────────────────────────────────────────────────
# Auth is bearer-token only; cookie-authenticated mutating routes are rejected.
# Set CSRF_ENABLED=true to additionally enforce double-submit CSRF tokens
# (SameSite=Strict cookies + X-CSRF-Token header) if cookie auth is ever enabled.
# Accepted values: true | false. Default: false (bearer-only).
CSRF_ENABLED=false

# ── Audit log storage ────────────────────────────────────────────────────────
# Audit events are stored in SQLite (WAL mode) with automatic retention.
# Path to the SQLite database file (created if missing).
AUDIT_DB_PATH=./data/audit.db
# Number of days to retain audit events; older rows are pruned by the retention job.
# Must be a positive integer.
AUDIT_RETENTION_DAYS=30
# Directory for JSONL export of audit events (kept for backward compatibility).
# Existing JSONL files in this directory are migrated into SQLite on startup.
AUDIT_JSONL_DIR=./data/audit
# Salt used to hash client IPs in audit events. When unset, a random salt is
# generated on first run and persisted to AUDIT_SALT_FILE (mode 0600) so IP
# hashes stay stable across restarts. If the salt file cannot be written, an
# ephemeral per-process salt is used and a startup warning is logged.
# Set this explicitly in production to control the salt yourself.
# AUDIT_SALT=change-me-to-a-long-random-string
# Path to the persisted salt file used when AUDIT_SALT is not set.
AUDIT_SALT_FILE=./data/audit-salt

# ── Embeddings (agent matching) ──────────────────────────────────────────────
# Agent embeddings are cached keyed by metadata hash and the model is lazy-loaded.
# Maximum number of cached agent embeddings (bounds memory usage).
# Must be a positive integer.
EMBEDDING_CACHE_MAX=1000
# Timeout in milliseconds for lazy-loading the embedding model.
# Must be a positive integer.
EMBEDDING_LOAD_TIMEOUT_MS=30000

# ── Readiness probe ──────────────────────────────────────────────────────────
# Timeout in milliseconds for each dependency check (RPC, indexer DB, model)
# performed by /readyz. Must be a positive integer.
READYZ_TIMEOUT_MS=2000

# ── Demo mode ────────────────────────────────────────────────────────────────
# Set DEMO_MODE=true to pre-seed fixed testnet keypairs and skip Freighter auth.
# This lets you run the full dashboard locally without a browser wallet extension.
# When DEMO_MODE=false (default), BUYER_SECRET and SELLER_SECRET must be set.
# Accepted values: true | false
DEMO_MODE=false

# ── Wallet secrets (required when DEMO_MODE=false) ───────────────────────────
# Stellar secret keys for the buyer and seller demo accounts.
# Must be valid Stellar StrKey Ed25519 secret seeds (start with "S", 56 chars).
# Generate with: stellar keys generate mykey --network testnet --fund
# WARNING: Never commit real keys. Use testnet keys only.
BUYER_SECRET=S...
SELLER_SECRET=S...