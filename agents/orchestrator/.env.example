SECRET_KEY=SXXXXX
REGISTRY_URL=http://localhost:3001
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Orchestrator retry policy
# Maximum number of attempts per task before it is marked as failed.
ORCHESTRATOR_MAX_ATTEMPTS=3
# Base delay (ms) for exponential backoff between retries.
ORCHESTRATOR_RETRY_BASE_MS=500
# Maximum delay (ms) cap for exponential backoff between retries.
ORCHESTRATOR_RETRY_MAX_MS=30000
# Timeout (ms) for polling a task's on-chain/registry status before giving up.
ORCHESTRATOR_POLL_TIMEOUT_MS=60000

# Orchestrator compensation behavior
# Enable compensation (cancel/refund) for tasks whose downstream dependents fail.
ORCHESTRATOR_ENABLE_COMPENSATION=true
# Maximum number of attempts for compensation (cancel/refund) operations.
ORCHESTRATOR_COMPENSATION_MAX_ATTEMPTS=3
# Base delay (ms) for exponential backoff between compensation retries.
ORCHESTRATOR_COMPENSATION_RETRY_BASE_MS=500
# Timeout (ms) for polling a compensation operation's status before giving up.
ORCHESTRATOR_COMPENSATION_POLL_TIMEOUT_MS=60000