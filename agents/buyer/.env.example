# agents/buyer/.env.example
# Copy to agents/buyer/.env and fill in values.
# See root .env.example for full variable reference.

# ── Stellar network ───────────────────────────────────────────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contract addresses (testnet) ──────────────────────────────────────────────
USDC_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
AGENT_IDENTITY_CONTRACT=CAMPXYFZJTIPEVOPOAZPRG5OHXKNBDPGTPRCOIO4LVPGEM4TONPY65A5
AGENTIC_COMMERCE_CONTRACT=CD2KWU7IE74Z2QKVP3FQ67J46XHNMGIDTNKXVWE7ZNVRC7T6UH46GQXE

# ── Buyer agent ───────────────────────────────────────────────────────────────
# Generate with: stellar keys generate buyer --network testnet --fund
# Must be a valid StrKey Ed25519 secret key (starts with "S").
SECRET_KEY=

# ── Agent registry ────────────────────────────────────────────────────────────
REGISTRY_URL=http://localhost:4500
REGISTRY_API_KEY=

# ── LLM routing (issue #650) ──────────────────────────────────────────────────
# Provider used to classify natural-language tasks and select a provider.
# Supported values: openai | anthropic
AGENT_LLM_PROVIDER=openai
# Model identifier for the selected provider.
#   openai    -> gpt-4o
#   anthropic -> claude-3-5-sonnet-latest
AGENT_LLM_MODEL=gpt-4o
# API key for the selected provider (OPENAI_API_KEY or ANTHROPIC_API_KEY).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Budget policy (issue #995) ────────────────────────────────────────────────
# All amounts are in USDC stroops (7 decimals): 1 USDC = 10_000_000 stroops.
# Hard cap on the amount the buyer agent may spend on a single job.
# Jobs priced above this are refused outright.
BUDGET_MAX_PER_JOB=100000000
# Maximum total spend per UTC day across all jobs. Once reached, new jobs are
# refused until the next day.
BUDGET_DAILY_CAP=1000000000
# Jobs at or above this amount require human approval before being paid.
# Leave empty (or 0) to disable the approval flow.
BUDGET_APPROVAL_THRESHOLD=50000000
# Optional approval webhook. When set, the agent POSTs the job details to this
# URL and expects a JSON response of the form { "approved": true }.
# Any other response (or a non-2xx status) is treated as a refusal.
BUDGET_APPROVAL_WEBHOOK=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the buyer agent HTTP server listens on (1-65535).
PORT=4501

# Optional polling tuning
BUYER_POLL_BASE_MS=2000
BUYER_POLL_MULTIPLIER=2
BUYER_POLL_MAX_ATTEMPTS=10
BUYER_POLL_CAP_MS=30000
