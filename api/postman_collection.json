{
  "info": {
    "name": "Bear Protocol API",
    "description": "REST API collection for Bear Protocol agent services. Includes registry, seller agents, and commerce endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Agent Registry (4500)",
      "description": "Service discovery and agent lifecycle management",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "{{api_key}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "List All Agents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{registry_url}}/agents",
              "host": ["{{registry_url}}"],
              "path": ["agents"]
            },
            "description": "Get list of all active agents currently heartbeating"
          },
          "response": []
        },
        {
          "name": "List Agents (with inactive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{registry_url}}/agents?include_inactive=true",
              "host": ["{{registry_url}}"],
              "path": ["agents"],
              "query": [
                {
                  "key": "include_inactive",
                  "value": "true"
                }
              ]
            },
            "description": "Get list of all agents including deregistered ones"
          },
          "response": []
        },
        {
          "name": "Filter Agents by Tag",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{registry_url}}/agents?tags=webdev",
              "host": ["{{registry_url}}"],
              "path": ["agents"],
              "query": [
                {
                  "key": "tags",
                  "value": "webdev"
                }
              ]
            },
            "description": "Filter agents by capability tags (case-insensitive)"
          },
          "response": []
        },
        {
          "name": "Filter Agents by Multiple Tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{registry_url}}/agents?tags=webdev,html",
              "host": ["{{registry_url}}"],
              "path": ["agents"],
              "query": [
                {
                  "key": "tags",
                  "value": "webdev,html"
                }
              ]
            },
            "description": "Filter agents by multiple tags (AND logic)"
          },
          "response": []
        },
        {
          "name": "Get Agent Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{registry_url}}/agents/seller-webbuilder",
              "host": ["{{registry_url}}"],
              "path": ["agents", "seller-webbuilder"]
            },
            "description": "Get manifest for a specific agent"
          },
          "response": []
        },
        {
          "name": "Deregister Agent",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{registry_url}}/agents/seller-webbuilder",
              "host": ["{{registry_url}}"],
              "path": ["agents", "seller-webbuilder"]
            },
            "description": "Manually deregister an agent"
          },
          "response": []
        },
        {
          "name": "Agent Heartbeat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": \"seller-webbuilder\"\n}"
            },
            "url": {
              "raw": "{{registry_url}}/heartbeat",
              "host": ["{{registry_url}}"],
              "path": ["heartbeat"]
            },
            "description": "Register or update an agent's heartbeat"
          },
          "response": []
        },
        {
          "name": "Registry Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{registry_url}}/health",
              "host": ["{{registry_url}}"],
              "path": ["health"]
            },
            "description": "Get registry status and agent count"
          },
          "response": []
        }
      ]
    },
